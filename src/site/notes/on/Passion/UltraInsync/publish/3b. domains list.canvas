---
{"dg-publish":true,"dg-path":"UltraInsync/publish/3b. domains list.canvas","permalink":"/ultra-insync/publish/3b-domains-list.canvas/","contentClasses":"canvas-page","dg-note-properties":{}}
---

<div id="3b_domains_list.canvas" class="canvas-wrapper hide">
	<svg class="canvas-background">
		<defs>
			<pattern id="canvas-grid-3b_domains_list.canvas" width="25" height="25" patternUnits="userSpaceOnUse">
				<circle r="1.5" cx="12.5" cy="12.5"></circle>
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill="url(#canvas-grid-3b_domains_list.canvas)"></rect>
	</svg>
	<div class="canvas">
		<svg class="canvas-edges-container" style="position:absolute;width:1px;height:1px;overflow:visible;">
			<defs><marker id="arrow-vartextmuted" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
			<path d="M0,0.5 L5,3 L0,5.5" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		</marker>
		<marker id="arrow-vartextmuted-start" markerWidth="6" markerHeight="6" refX="1" refY="3" orient="auto-start-reverse" markerUnits="strokeWidth">
			<path d="M6,0.5 L1,3 L6,5.5" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
		</marker><filter x="-0.1" y="-0.1" width="1.2" height="1.3" id="edge-label-bg">
			<feFlood flood-color="var(--background-primary)" flood-opacity="1" result="bg"/>
			<feMerge>
				<feMergeNode in="bg"/>
				<feMergeNode in="SourceGraphic"/>
			</feMerge>
		</filter></defs><path d="M 70 -480 C 70 -430, 170 -490, 170 -440" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="01728070e3541cec"  marker-end="url(#arrow-vartextmuted)" />
<path d="M 70 -480 C 70 -429.40355743730595, -50 -490.59644256269405, -50 -440" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="af4963684177460a"  marker-end="url(#arrow-vartextmuted)" />
		</svg>
		<div class="canvas-node canvas-node-text " data-node-id="8fba1fda4234a737" style="transform: translate(80px, -440px); width: 180px; height: 120px; ">
	<div class="canvas-node-container">
		<div class="canvas-node-content markdown-rendered" style="text-align: center;">
			<div class="canvas-node-text-content" data-markdown="IyMjIyMjIGRldgpkc3ZpLnNlCmFkc3ZpLnNlCmFkc3Zpc2UubWUK"></div>
		</div>
	</div>
</div>
<div class="canvas-node canvas-node-text " data-node-id="ec63b5c7fcbafce8" style="transform: translate(-120px, -440px); width: 140px; height: 100px; ">
	<div class="canvas-node-container">
		<div class="canvas-node-content markdown-rendered" style="text-align: center;">
			<div class="canvas-node-text-content" data-markdown="IyMjIyMjIFByb2QKYWRzdmlzZS5sbGMKdGF4bGVzcy5teQ=="></div>
		</div>
	</div>
</div>
<div class="canvas-node canvas-node-text " data-node-id="795645edb439db7c" style="transform: translate(0px, -540px); width: 140px; height: 60px; ">
	<div class="canvas-node-container">
		<div class="canvas-node-content markdown-rendered" style="text-align: center;">
