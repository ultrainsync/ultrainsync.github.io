		</marker><filter x="-0.1" y="-0.1" width="1.2" height="1.3" id="edge-label-bg">
			<feFlood flood-color="var(--background-primary)" flood-opacity="1" result="bg"/>
			<feMerge>
				<feMergeNode in="bg"/>
				<feMergeNode in="SourceGraphic"/>
			</feMerge>
		</filter></defs><path d="M -360 -300 C -360 -250, -360 -270, -360 -220" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="173794c3317fb167"  marker-end="url(#arrow-vartextmuted)" /><text x="-360" y="-260" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">commentary (based on Suhaib RA)</text>
<path d="M -350 0 C -350 50, -350 50, -350 100" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="a40af80c9c8461e5"  marker-end="url(#arrow-vartextmuted)" /><text x="-350" y="50" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">untuk membakar</text>
<path d="M -350 200 C -350 250, -350 250, -350 300" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="e7b71328889fd603"  marker-end="url(#arrow-vartextmuted)" /><text x="-350" y="250" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">martyr</text>
