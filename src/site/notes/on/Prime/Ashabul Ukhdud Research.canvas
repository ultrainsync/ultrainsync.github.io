<div id="Ashabul_Ukhdud_Researchcanvas" class="canvas-wrapper hide">
	<svg class="canvas-background">
		<defs>
			<pattern id="canvas-grid-Ashabul_Ukhdud_Researchcanvas" width="25" height="25" patternUnits="userSpaceOnUse">
				<circle r="1.5" cx="12.5" cy="12.5"></circle>
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill="url(#canvas-grid-Ashabul_Ukhdud_Researchcanvas)"></rect>
	</svg>
	<div class="canvas">
